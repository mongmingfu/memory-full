# memory_full 配置模板
# 复制成 config.yaml，填上你的 key

port: 8088
db_path: memory.db

llm:
  enabled: true
  base_url: https://api.deepseek.com/v1
  api_key: sk-你的key
  model: deepseek-chat
  max_tokens: 16000
  temperature: 0.3

memory:
  user_names:
    - User
    - 你的名字
  decay_rate: 0.01
  merge_interval_min: 120
